{
  "manifest_version": 3,
  "name": "Monarchy for Windows",
  "version": "0.1.0",
  "description": "Sends approved Sol's RNG links from the visible Discord channel to local Monarchy.",
  "permissions": [],
  "host_permissions": ["http://127.0.0.1:17381/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://discord.com/channels/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
